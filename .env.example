# Copy to .env and fill in real values. NEVER commit the real .env.

# ── Core ──────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ORIGIN_ALLOW_ALL=False

# ── Application database (managed models — migrations run here) ────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hf_group_app
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Legacy data warehouse (unmanaged/read-only models) ────────────
DW_ENGINE=django.db.backends.postgresql
DW_NAME=datawarehouse
DW_USER=datawarehouse
DW_PASSWORD=
DW_HOST=
DW_PORT=5432

# Cache uses Django DatabaseCache (app DB) — no Redis/broker to configure.

# ── Email (OTP / password reset) ──────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=reports.analytics@hfgroup.co.ke

# ── Branding + access links shown in outgoing emails ──────────────
# Name shown in email subjects/bodies, and the two URLs users use to reach the
# tool (both are included in every email: OTP, password reset, new-account).
APP_BRAND_NAME=HFCB
FRONTEND_PUBLIC_URL=https://ceo.hfgroup.co.ke
FRONTEND_LAN_URL=http://128.2.1.25:5400

# ── AI ────────────────────────────────────────────────────────────
# Required for the AI assistant to answer; without it the agent replies "not configured".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── JWT token lifetimes (days) ────────────────────────────────────
ACCESS_TOKEN_LIFETIME_DAYS=1
REFRESH_TOKEN_LIFETIME_DAYS=7
